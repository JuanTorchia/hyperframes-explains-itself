{
  "name": "hyperframes-explains-itself",
  "version": "0.1.0",
  "description": "Use HyperFrames to explain HyperFrames.",
  "private": true,
  "type": "module",
  "scripts": {
    "doctor": "hyperframes doctor",
    "doctor:docker": "docker version && docker info",
    "dev": "hyperframes preview --no-open",
    "preview": "hyperframes preview",
    "lint": "hyperframes lint",
    "inspect": "hyperframes inspect",
    "check": "npm run lint && npm run inspect",
    "snapshot": "hyperframes snapshot --at 0,36,69,105 --describe false && node tools/move-snapshots.mjs",
    "experiment:media:check": "hyperframes lint experiments/001-media-timing && hyperframes inspect experiments/001-media-timing",
    "experiment:media:render": "hyperframes render experiments/001-media-timing --docker --strict-all --workers 1 --output experiments/001-media-timing/output/media-timing-proof.mp4",
    "experiment:captions:check": "hyperframes lint experiments/008-captions-layer && hyperframes inspect experiments/008-captions-layer",
    "experiment:captions:render": "hyperframes render experiments/008-captions-layer --docker --strict-all --workers 1 --output experiments/008-captions-layer/output/captions-layer-proof.mp4",
    "experiment:track:check": "hyperframes lint experiments/009-track-attributes && hyperframes inspect experiments/009-track-attributes",
    "experiment:track:render": "hyperframes render experiments/009-track-attributes --docker --strict-all --workers 1 --output experiments/009-track-attributes/output/track-attributes-proof.mp4",
    "experiment:social:check": "hyperframes lint experiments/010-social-aspects/landscape && hyperframes inspect experiments/010-social-aspects/landscape && hyperframes lint experiments/010-social-aspects/portrait && hyperframes inspect experiments/010-social-aspects/portrait && hyperframes lint experiments/010-social-aspects/square && hyperframes inspect experiments/010-social-aspects/square",
    "experiment:social:render": "node tools/run-social-aspects-evidence.mjs",
    "experiment:render-controls:check": "hyperframes lint experiments/011-render-controls && hyperframes inspect experiments/011-render-controls",
    "experiment:render-controls:render": "node tools/run-render-controls-evidence.mjs",
    "experiment:waapi:check": "hyperframes lint experiments/012-waapi-adapter && hyperframes inspect experiments/012-waapi-adapter",
    "experiment:waapi:render": "hyperframes render experiments/012-waapi-adapter --docker --strict-all --workers 1 --output experiments/012-waapi-adapter/output/waapi-adapter-proof.mp4",
    "experiment:frames": "node tools/extract-experiment-frames.mjs",
    "experiment:adapters:prepare": "node tools/run-adapter-evidence.mjs prepare",
    "experiment:adapters:check": "node tools/run-adapter-evidence.mjs check",
    "experiment:adapters:render": "node tools/run-adapter-evidence.mjs render",
    "experiment:adapters:frames": "node tools/run-adapter-evidence.mjs frames",
    "experiment:formats:webm": "hyperframes render experiments/001-media-timing --docker --strict-all --workers 1 --format webm --output experiments/002-output-formats/output/media-timing-proof.webm",
    "experiment:formats:png": "hyperframes render experiments/002-output-formats/png-sequence --docker --strict-all --workers 1 --format png-sequence --output experiments/002-output-formats/output/png-sequence-proof-frames",
    "experiment:introspection": "node tools/run-introspection-evidence.mjs",
    "experiment:benchmark": "node tools/run-benchmark-evidence.mjs",
    "experiment:transcribe": "node tools/run-transcription-evidence.mjs",
    "experiment:transcribe:official": "node tools/run-official-transcription-evidence.mjs",
    "experiment:captions": "node tools/run-caption-layer-evidence.mjs",
    "experiment:main-captions": "node tools/run-main-caption-evidence.mjs",
    "experiment:capture": "node tools/run-local-capture.mjs",
    "transcribe:setup": "node tools/setup-whisper-python.mjs",
    "transcribe:setup:official": "node tools/setup-whisper-official.mjs",
    "tts:setup": "node tools/setup-tts-python.mjs",
    "tts": "node tools/run-with-venv.mjs hyperframes tts audio/source/voiceover.txt --voice af_nova --lang en-us --speed 1.15 --output audio/generated/hyperframes-in-60-seconds-af-nova.wav",
    "render": "hyperframes render --docker --strict-all --workers 1 --output renders/hyperframes-in-60-seconds.mp4",
    "render:captions": "node tools/render-main-with-captions.mjs",
    "render:local": "hyperframes render --strict-all --workers 1 --output renders/hyperframes-in-60-seconds.mp4"
  },
  "keywords": [
    "hyperframes",
    "html-video",
    "tutorial",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "animejs": "4.4.1",
    "d3": "7.9.0",
    "esbuild": "0.28.0",
    "ffmpeg-static": "5.3.0",
    "gsap": "3.14.2",
    "hyperframes": "0.6.80",
    "lottie-web": "5.13.0",
    "three": "0.184.0"
  }
}
