{
  "name": "hyperframes-explains-itself",
  "version": "0.1.0",
  "description": "Use HyperFrames to explain HyperFrames.",
  "private": true,
  "type": "module",
  "scripts": {
    "doctor": "hyperframes doctor",
    "doctor:docker": "docker version && docker info",
    "dev": "hyperframes preview --no-open",
    "preview": "hyperframes preview",
    "lint": "hyperframes lint",
    "inspect": "hyperframes inspect",
    "check": "npm run lint && npm run inspect",
    "snapshot": "hyperframes snapshot --at 0,36,69,105 --describe false && node tools/move-snapshots.mjs",
    "experiment:media:check": "hyperframes lint experiments/001-media-timing && hyperframes inspect experiments/001-media-timing",
    "experiment:media:render": "hyperframes render experiments/001-media-timing --docker --strict-all --workers 1 --output experiments/001-media-timing/output/media-timing-proof.mp4",
    "experiment:formats:webm": "hyperframes render experiments/001-media-timing --docker --strict-all --workers 1 --format webm --output experiments/002-output-formats/output/media-timing-proof.webm",
    "experiment:formats:png": "hyperframes render experiments/001-media-timing --docker --strict-all --workers 1 --format png-sequence --output experiments/002-output-formats/output/media-timing-proof-frames",
    "experiment:introspection": "node tools/run-introspection-evidence.mjs",
    "experiment:benchmark": "hyperframes benchmark experiments/004-benchmark/minimal --runs 1 --json",
    "experiment:capture": "node tools/run-local-capture.mjs",
    "tts:setup": "node tools/setup-tts-python.mjs",
    "tts": "node tools/run-with-venv.mjs hyperframes tts audio/source/voiceover.txt --voice af_nova --lang en-us --speed 1.15 --output audio/generated/hyperframes-in-60-seconds-af-nova.wav",
    "render": "hyperframes render --docker --strict-all --workers 1 --output renders/hyperframes-in-60-seconds.mp4",
    "render:local": "hyperframes render --strict-all --workers 1 --output renders/hyperframes-in-60-seconds.mp4"
  },
  "keywords": [
    "hyperframes",
    "html-video",
    "tutorial",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.6.80"
  }
}
